rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ແອດມິນ: ຕ້ອງເຂົ້າສູ່ລະບົບດ້ວຍ Google ແລະ ອີເມວຢືນຢັນແລ້ວ
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['kkem295@gmail.com', 'Kkem295@gmail.com'];
    }

    // ແອດມິນເຂົ້າເຖິງໄດ້ທຸກຢ່າງ
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ໂປຣໄຟລ໌ຜູ້ໃຊ້: ແຕ່ລະຄົນອ່ານ/ຂຽນໄດ້ສະເພາະຂອງຕົນເອງ
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['email', 'fname', 'lname', 'dname', 'phone', 'country', 'createdAt', 'lastSeen'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.fname.size() <= 40
        && request.resource.data.lname.size() <= 40
        && request.resource.data.dname.size() <= 40
        && request.resource.data.phone.size() <= 20;
    }

    // ສະຖິຕິເຂົ້າໃຊ້ລາຍວັນ: ທຸກຄົນເພີ່ມໄດ້ເທື່ອລະ 1 ເທົ່ານັ້ນ
    match /stats/{day} {
      allow create: if request.resource.data.keys().hasOnly(['date', 'visits'])
        && request.resource.data.visits == 1
        && request.resource.data.date == day;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1;
    }

    // ຜູ້ໃຊ້ທີ່ເຂົ້າສູ່ລະບົບໃນແຕ່ລະວັນ (ນັບ DAU)
    match /activity/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['date', 'uid'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.date + '_' + request.auth.uid;
    }

    // ຜູ້ເຂົ້າຊົມທຸກຄົນ (ລວມຄົນບໍ່ໄດ້ເຂົ້າສູ່ລະບົບ): ຂຽນໄດ້ສະເພາະຂໍ້ມູນຕົນເອງ, ອ່ານໄດ້ສະເພາະແອດມິນ
    match /visitors/{vid} {
      allow create, update: if request.resource.data.keys().hasOnly(
             ['vid', 'country', 'tz', 'lang', 'dev', 'first', 'last', 'days', 'uid', 'em'])
        && request.resource.data.vid == vid
        && vid.size() >= 16 && vid.size() <= 40
        && request.resource.data.country is string && request.resource.data.country.size() <= 2
        && request.resource.data.tz.size() <= 40
        && request.resource.data.lang.size() <= 10
        && request.resource.data.dev.size() <= 10
        && request.resource.data.first is number
        && request.resource.data.last is number
        && request.resource.data.days is number
        && (!('uid' in request.resource.data) || (request.resource.data.uid is string && request.resource.data.uid.size() <= 40))
        && (!('em' in request.resource.data) || (request.resource.data.em is string && request.resource.data.em.size() <= 200));
    }

    // ຕັ້ງຄ່າສາທາລະນະ (ຄຳສັບທີ່ແອດມິນເພີ່ມ/ແກ້, ປະກາດ): ທຸກຄົນອ່ານໄດ້, ແອດມິນຂຽນໄດ້
    match /config/{docId} {
      allow read: if true;
    }

    // ຮູບພາບທີ່ແອດມິນເພີ່ມ: ທຸກຄົນອ່ານໄດ້, ແອດມິນຂຽນໄດ້
    match /pics/{id} {
      allow read: if true;
    }
  }
}
